{
  "name": "Magpie",
  "short_name": "Magpie",
  "description": "A tamper-evident incident journal. Photos, notes, and files, encrypted on your device and hash-chained so the record cannot be quietly rewritten.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#eef2f0",
  "theme_color": "#eef2f0",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/magpie.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "evidence", "accept": ["image/*", "application/pdf", "text/plain", "audio/*", "video/*"] }]
    }
  }
}
